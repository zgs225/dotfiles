{
  "lastChangelogVersion": "1.5.2",
  "theme": "song-liquid-glass",
  "defaultProvider": "cliproxyapi",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "defaultProjectTrust": "always",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "transport": "websocket-cached",
  "editorPaddingX": 1,
  "autocompleteMaxVisible": 10,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep"
  ],
  "branchSummary": {
    "skipPrompt": true
  },
  "enabledModels": [
    "cliproxyapi/*",
    "cliproxyapi/official/*",
    "cliproxyapi/opencode/*"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 100,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 300000
    }
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@router-for-me/pi-cliproxyapi-provider"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0"
  }
}