/* GTK3 glassmorphism theme — matches eww popup style.
 * Managed by chezmoi; colors come from .chezmoi.yaml.tmpl data block.
 *
 * NOTE: this must live in a THEME (loaded at GTK_STYLE_PROVIDER_PRIORITY_THEME),
 * not in ~/.config/gtk-3.0/gtk.css (USER priority). USER-priority rules beat
 * everything an application sets — including all of eww's own SCSS, since eww
 * loads its CSS at APPLICATION priority — so any rule here would leak into
 * eww widgets (rounded light backgrounds on bar buttons, wifi list rows, ...).
 * At theme priority, eww's SCSS always wins and regular GTK3 apps still get
 * the glass look.
 */

@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained-dark.css");

@define-color base {{ .colors.bg_base }};
@define-color mantle {{ .colors.bg_elevated }};
@define-color crust #15151a;
@define-color surface0 {{ .colors.ink }};
@define-color surface1 #3a3a44;
@define-color surface2 #464652;
@define-color text {{ .colors.fg_primary }};
@define-color subtext1 #cfccc2;
@define-color subtext0 {{ .colors.fg_secondary }};
@define-color overlay0 #6f6f68;
@define-color overlay1 #85857d;
@define-color lavender {{ .colors.accent }};
@define-color blue {{ .colors.accent }};
@define-color seal {{ .colors.error }};

/* ── Menus and context menus (system tray, right-click, etc.) ──
 * Song standard S4.5: L4 glass 0.60 + 5px radius + tianqing hairline;
 * item hover = S4.3 jie-yin (2px left accent bar).
 * Font sizes and paddings are in pt: GTK converts pt through Xft.dpi, so
 * displayctl's DPI tiers (96/144/192) keep the physical size constant —
 * no per-tier baking needed, unlike eww geometry.
 * Electron/Tauri tray menus (aTrust, DingTalk, clash-verge) are GtkMenu
 * and inherit everything below. */
menu,
.context-menu,
.menu {
  background-color: alpha(@base, 0.60);
  border: 1px solid alpha(@lavender, 0.35);
  border-radius: 5px;
  padding: 6pt;
  color: @text;
  font-size: 11.5pt;
}

menuitem,
.menuitem {
  color: @subtext1;
  padding: 5pt 10pt;
  border-radius: 3px;
  border-left: 2px solid transparent;
}

menuitem:hover,
menuitem:selected,
.menuitem:hover,
.menuitem:selected {
  color: @text;
  background-color: alpha(@surface1, 0.40);
  border-left-color: @lavender;
}

menuitem:disabled,
.menuitem:disabled {
  color: alpha(@overlay0, 0.60);
}

menu separator,
.menu separator {
  background-color: alpha(@lavender, 0.15);
  min-height: 1px;
  margin: 4pt 4pt;
}

menu > arrow {
  color: @subtext0;
}

/* ── Popovers (newer GTK3 apps replace menus with popovers) ──
 * Popover = L2 functional panel 0.65 (S2.2). */
popover {
  background-color: alpha(@base, 0.65);
  border: 1px solid alpha(@lavender, 0.35);
  border-radius: 5px;
  padding: 6pt;
  color: @text;
  font-size: 11.5pt;
}

popover modelbutton {
  color: @subtext1;
  padding: 5pt 10pt;
  border-radius: 3px;
  border-left: 2px solid transparent;
}

popover modelbutton:hover,
popover modelbutton:selected {
  color: @text;
  background-color: alpha(@surface1, 0.40);
  border-left-color: @lavender;
}

popover separator {
  background-color: alpha(@lavender, 0.15);
  min-height: 1px;
  margin: 4pt 4pt;
}

/* ── Tooltips ── */
tooltip {
  background-color: alpha(@base, 0.92);
  border: 1px solid alpha(@lavender, 0.25);
  border-radius: 5px;
  padding: 4pt 7pt;
  color: @text;
  font-size: 10pt;
}

/* ============================================================ MAIN APPLICATION WINDOWS ============================================================ */
/*
 * These rules apply to GTK3 system applications (file managers, settings, etc.)
 * to give them the same glassmorphism look as eww popups. They may need
 * per-app tweaks if a specific application renders badly.
 */

window,
dialog {
  background-color: alpha(@base, 0.80);
  color: @text;
}

/* Treeview / list views (file lists, settings lists) */
treeview,
treeview.view,
.view {
  background-color: alpha(@surface0, 0.55);
  color: @text;
}

treeview:selected,
treeview.view:selected,
.view:selected {
  background-color: alpha(@lavender, 0.45);
  color: @text;
}

treeview:selected:focus,
treeview.view:selected:focus,
.view:selected:focus {
  background-color: alpha(@lavender, 0.55);
  color: @text;
}

/* Sidebar / places pane */
.sidebar,
.sidebar .view,
.sidebar treeview {
  background-color: alpha(@surface0, 0.55);
  color: @text;
}

/* Notebook / tabs */
notebook {
  background-color: alpha(@surface0, 0.50);
}

notebook header {
  background-color: alpha(@surface0, 0.45);
}

notebook tab {
  background-color: alpha(@surface1, 0.30);
  color: @subtext1;
  padding: 6px 12px;
}

notebook tab:checked {
  background-color: alpha(@lavender, 0.35);
  color: @text;
}

/* Toolbars and menubars */
toolbar,
menubar {
  background-color: alpha(@surface0, 0.55);
  color: @text;
}

/* Entries / inputs */
entry {
  background-color: alpha(@surface0, 0.55);
  color: @text;
  border: 1px solid alpha(@text, 0.12);
  border-radius: 8px;
  padding: 6px 10px;
}

entry:focus {
  border-color: alpha(@lavender, 0.60);
}

/* Buttons */
button {
  background-color: alpha(@surface1, 0.40);
  color: @text;
  border: 1px solid alpha(@text, 0.12);
  border-radius: 8px;
  padding: 6px 12px;
}

button:hover {
  background-color: alpha(@surface1, 0.60);
}

button:active,
button:checked {
  background-color: alpha(@lavender, 0.40);
}

/* Scrolled windows / viewports */
scrolledwindow {
  background-color: transparent;
}

/* General separators */
separator {
  background-color: alpha(@text, 0.08);
}

/* ── LightDM GTK Greeter — 门籍签 (login ticket) v2 ─────────────────
 * The greeter runs as the lightdm user against the system copy of this
 * theme (/usr/share/themes/catppuccin-glass). Widget IDs are unique to
 * lightdm-gtk-greeter, so nothing here leaks into other GTK apps.
 *
 * Real widget tree (read from src/lightdm-gtk-greeter.glade, 2.0.9):
 *   #panel_window > menubar                top indicators, sunk into silk
 *   #login_window > #login_box (vertical) >
 *     #content_frame > grid1 >
 *       #user_image_border > #user_image   hidden via hide-user-image=true
 *       #user_combobox                     the identity row (single user)
 *       #prompt_entry                      !! both username_entry and
 *                                          password_entry carry the
 *                                          runtime NAME "prompt_entry" —
 *                                          the glade ids never match CSS
 *     #greeter_infobar > #message_label    the 赭石 error stone-bar
 *     #buttonbox_frame > box2 > #cancel_button + #login_button
 *   #power_window                          shutdown/restart confirm
 *
 * Hard-won platform gotchas (v1 autopsy, 2026-08-05):
 *   - entries are renamed #prompt_entry at build time; #password_entry
 *     and #username_entry are dead selectors.
 *   - GTK 3.24 node names only: `menubar`, `menuitem`, `button`, `arrow`.
 *     Legacy classes (.menubar/.button) silently never match.
 *   - the greeter injects its own fallback CSS at APPLICATION priority;
 *     defining @define-color lightdm-gtk-greeter-override-defaults
 *     demotes it to FALLBACK (upstream hand-over protocol).
 *   - GtkFrame draws its line on the `frame > border` subnode; styling
 *     the #id alone leaves a black groove (the v1 bottom strip).
 *   - GTK3 engine: no blur in box-shadow, no animation. Feedback is
 *     instantaneous colour change only — focus brightens the underline
 *     (lock-screen discipline: 静如立轴). */

/* declare the take-over (see gotcha 3) */
@define-color lightdm-gtk-greeter-override-defaults {{ .colors.bg_base }};

/* top indicator bar — fully transparent, captions sunk to faint crab-green */
#panel_window {
  background: none;
  background-image: none;
}
#panel_window menubar,
#panel_window menubar > menuitem {
  background: none;
  background-image: none;
  color: alpha(@subtext0, 0.66);
  font-size: 13px;
  padding: 6px 10px;
}
#panel_window menubar > menuitem:hover {
  background-color: alpha(@surface1, 0.30);
  color: @text;
}

/* the ticket body — L2 silk 0.65 + tianqing hairline + a breath of top light */
#login_window,
#power_window {
  border: 1px solid alpha(@lavender, 0.35);
  border-radius: 5px;
  background-color: alpha(@base, 0.65);
  box-shadow: none;
  color: @text;
}

/* top light sheen — ISOLATED rule: GTK3 drops the rest of a rule block
 * after a bad declaration; a gradient must never share a block with the
 * box-shadow reset that kills Adwaita's .keycap inset slab (S8.10) */
#login_window,
#power_window {
  background-image: linear-gradient(to bottom, alpha(@text, 0.05), transparent 28px);
}

/* 乌丝栏 — left ruling, spans the whole ticket height */
#login_window #login_box {
  border-left: 2px solid alpha(@lavender, 0.40);
}

/* kill the GtkFrame groove (gotcha 4) */
#login_window frame > border,
#power_window frame > border {
  border: none;
  box-shadow: none;
}

/* asymmetric breathing: roomier right, ruling-side tighter */
#login_window #content_frame {
  padding: 26px 32px 10px 24px;
}
#login_window #buttonbox_frame {
  padding: 6px 32px 22px 24px;
}

/* identity row — the combobox stripped to bare calligraphy */
#login_window #user_combobox,
#login_window #user_combobox cellview,
#login_window #user_combobox button,
#login_window #user_combobox button:hover,
#login_window #user_combobox button:focus,
#login_window #user_combobox button:checked {
  background: none;
  background-image: none;
  border: none;
  box-shadow: none;
  border-radius: 0;
  padding: 0 0 2px 0;
  color: @text;
  font-size: 20px;
  font-weight: bold;
}
#login_window #user_combobox arrow {
  color: alpha(@lavender, 0.80);
}

/* 口令 fill-line — a single tianqing underline, no box */
#login_window #prompt_entry {
  background: none;
  background-image: none;
  border: none;
  border-bottom: 2px solid alpha(@lavender, 0.50);
  border-radius: 0;
  box-shadow: none;
  color: @text;
  caret-color: @lavender;
  padding: 8px 2px;
  font-size: 18px;
}
#login_window #prompt_entry:focus {
  border-bottom-color: alpha(@lavender, 0.92);
  box-shadow: none;
}
#login_window #prompt_entry selection {
  background-color: alpha(@lavender, 0.35);
  color: @text;
}

/* avatar, if ever shown — square seal frame, not a circle */
#login_window #user_image_border {
  border: 1px solid alpha(@lavender, 0.35);
  border-radius: 3px;
  background: none;
  box-shadow: none;
  padding: 0;
}

/* error stone-bar — the only element that tints on auth failure */
#login_window #greeter_infobar {
  border: none;
  border-radius: 3px;
  background-color: alpha(@seal, 0.14);
  background-image: none;
  box-shadow: none;
  margin: 8px 24px 0 24px;
}
#login_window #greeter_infobar label {
  color: @seal;
  font-size: 13px;
}

/* button row — cancel as quiet ghost, login as tianqing plaque */
#login_window #buttonbox_frame {
  background: none;
  background-image: none;
  border: none;
  box-shadow: none;
}
#login_window #cancel_button {
  background: none;
  background-image: none;
  border: none;
  box-shadow: none;
  color: alpha(@subtext0, 0.85);
  font-size: 14px;
}
#login_window #cancel_button:hover {
  background: none;
  background-image: none;
  box-shadow: none;
  color: @text;
}
#login_window #login_button {
  background-color: alpha(@lavender, 0.12);
  background-image: none;
  border: 1px solid alpha(@lavender, 0.45);
  border-radius: 4px;
  box-shadow: none;
  color: @text;
  font-size: 16px;
  font-weight: bold;
  padding: 9px 28px;
}
#login_window #login_button:hover {
  background-color: alpha(@lavender, 0.24);
  border-color: alpha(@lavender, 0.70);
}
#login_window #login_button:active {
  background-color: alpha(@lavender, 0.32);
  border-color: alpha(@lavender, 0.85);
}
#login_window #login_button:focus,
#login_window #login_button.default {
  background-color: alpha(@lavender, 0.16);
  background-image: none;
  border-color: alpha(@lavender, 0.55);
  box-shadow: none;
  color: @text;
}

/* power dialog mirrors the ticket */
#power_window #power_content_frame {
  padding: 22px 28px 10px 24px;
}
#power_window #power_buttonbox_frame {
  padding: 6px 28px 20px 24px;
}
#power_window #power_ok_button {
  background-color: alpha(@seal, 0.12);
  border: 1px solid alpha(@seal, 0.45);
  border-radius: 4px;
  box-shadow: none;
  color: @text;
  padding: 8px 24px;
}
#power_window #power_cancel_button {
  background: none;
  border: none;
  box-shadow: none;
  color: alpha(@subtext0, 0.85);
}
#power_window #power_cancel_button:hover {
  background: none;
  color: @text;
}
