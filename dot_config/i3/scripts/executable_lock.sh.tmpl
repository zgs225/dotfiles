#!/usr/bin/env bash
set -euo pipefail

# Single lock instance: xidlehook auto-lock can overlap a manual $mod+Shift+l.
# A second i3lock would wait on the input grab and double up on auth handling
# (2026-07: duplicate instances raced for the fprintd device claim).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/i3-lock.${UID}.lock"
flock -n 9 || exit 0

CACHE_DIR="$HOME/.cache/lockscreen"
RENDER_SCRIPT="$HOME/.config/i3/scripts/lock-render.py"

dunstctl set-paused true 2>/dev/null || true
trap 'dunstctl set-paused false 2>/dev/null || true' EXIT

COMPOSE="$CACHE_DIR/_compose.jpg"
SOCK="$CACHE_DIR/sock"
img=""

if [[ -S "$SOCK" ]] && python3 -c '
import socket, sys, os
# The daemon renders the whole X root (multi-monitor stitching, e.g.
# 6400x2160) in 1.5-2s once warm; a cold start (blurred base rebuild) is ~4s.
# 8s is already 2x headroom over the cold path. Do NOT raise it: a wedged
# daemon would then keep this script blocked for ten-plus extra seconds with
# the desktop still visible, which is a privacy regression. Timing out here
# only costs the synchronous fallback render (~2s).
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(8)
try:
    s.connect(os.path.expanduser("~/.cache/lockscreen/sock"))
    s.sendall(b"L\n")
    r = s.recv(8).strip()
    sys.exit(0 if r == b"ok" else 1)
except Exception:
    sys.exit(2)
' 2>/dev/null && [[ -f "$COMPOSE" ]]; then
    img="$COMPOSE"
elif img=$(python3 "$RENDER_SCRIPT" --lock-image "$COMPOSE" 2>/dev/null) && [[ -f "$img" ]]; then
    :
else
    dunstctl set-paused false 2>/dev/null || true
    i3lock -n -c 1a1a1e &
    lock_pid=$!
    trap 'kill "$lock_pid" 2>/dev/null || true' TERM INT
    wait "$lock_pid" || true
    exit 0
fi

geom=$(xrandr --current 2>/dev/null | grep -m1 ' connected' | grep -oP '\d+x\d+' | head -1)
W=${geom%%x*}
H=${geom##*x}
W=${W:-2560}
H=${H:-1600}

dpi=$(xrdb -query 2>/dev/null | sed -n 's/.*Xft\.dpi:[[:space:]]*\([0-9.]*\).*/\1/p')
dpi=${dpi:-96}

read -r cx cy radius ringw < <(awk -v w="$W" -v h="$H" -v dpi="$dpi" 'BEGIN{
  s=dpi/96;
  printf "%d %d %d %.2f\n", (w/2)/s, (h*0.55)/s, 80/s, 4/s
}')

i3lock \
    -n \
    -i "$img" \
    --indicator \
    --radius=$radius \
    --ring-width=$ringw \
    --ind-pos="${cx}:${cy}" \
    --ring-color={{ .colors.accent | trimPrefix "#" }}44 \
    --ringver-color={{ .colors.accent | trimPrefix "#" }}aa \
    --ringwrong-color={{ .colors.error | trimPrefix "#" }}ff \
    --inside-color=00000000 \
    --insidever-color=00000000 \
    --insidewrong-color=00000000 \
    --line-uses-ring \
    --keyhl-color={{ .colors.accent | trimPrefix "#" }}ff \
    --bshl-color={{ .colors.warn | trimPrefix "#" }}ff \
    --verif-color=00000000 \
    --wrong-color=00000000 \
    --separator-color=00000000 &
lock_pid=$!
# Propagate TERM/INT to i3lock: killing lock.sh must not leave an orphaned
# i3lock holding the screen and input grab (observed during testing).
trap 'kill "$lock_pid" 2>/dev/null || true' TERM INT
wait "$lock_pid" || true
