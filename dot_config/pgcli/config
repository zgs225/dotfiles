sql.quoted-schema-object = '#7aa2f7'
sql.quoted-schema-object.escape = '#e0af68'
sql.constant = '#ff9e64'
sql.function = '#7aa2f7'
sql.variable = '#a9b1d6'
sql.number = '#ff9e64'
sql.number.binary = '#bb9af7'
sql.number.float = '#ff9e64'
sql.number.hex = '#9ece6a'
sql.number.integer = '#ff9e64'
sql.operator = '#7dcfff'
sql.punctuation = '#a9b1d6'
