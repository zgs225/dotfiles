{{- $eww := includeTemplate "eww-sizes" . | fromJson -}}
;; ============================================ CALENDAR POPUP ============================================

(defwindow calendar-popup [pos_x pos_y]
  :stacking "overlay"
  :windowtype "dialog"
  :focusable false
  :geometry (geometry :width "{{ $eww.calendarW }}px" :height "{{ $eww.calendarH }}px" :x { pos_x } :y { pos_y } :anchor "top left")
  (box :class "popup revealer calendar-popup" :orientation "v" :spacing 0 :space-evenly false
    (calendar :class "cal"
      :day "${calendar_monthday}"
      :month "${calendar_month}"
      :year "${calendar_year}"
      :show-heading true
      :show-day-names true
      :show-details false)

    (box :class "separator-line")

    ;; Date navigation bar
    (box :orientation "h" :spacing 6 :class "cal-nav" :space-evenly false :valign "center"
      (button :class "cal-nav-btn" :onclick "~/.config/eww/scripts/cal-nav.sh prev"
        (label :text "‹" :class "cal-nav-arrow"))
      (label :text "${cal_date_label}" :class "cal-nav-label" :xalign 0 :hexpand true)
      (button :class "cal-nav-btn cal-nav-today" :onclick "~/.config/eww/scripts/cal-nav.sh today"
        (label :text "今天" :class "cal-nav-today-label"))
      (button :class "cal-nav-btn" :onclick "~/.config/eww/scripts/cal-nav.sh next"
        (label :text "›" :class "cal-nav-arrow"))
      (button :class "cal-nav-btn cal-nav-add" :onclick "~/.config/eww/scripts/cal-add-action.sh init"
        (label :text "+" :class "cal-nav-add-label")))

    ;; Events list — full width
    (scroll :vscroll true :hscroll false :vexpand true :class "cal-events-scroll"
      (literal :content "${events}"))))
