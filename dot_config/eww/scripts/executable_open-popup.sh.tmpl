#!/usr/bin/env bash
# Popup state manager — intent queue + single worker.
# Usage: open-popup.sh <popup-name|close>
#
# Architecture (2026-08 rewrite, replaces the per-click flock-queue design):
#   Every click only APPENDS an intent line and then tries to become the
#   worker via flock. Exactly one worker exists at any time; it drains the
#   intent queue in order. Clicks are therefore never dropped and never
#   wait behind a queue of heavyweight processes — the old design serialized
#   every click behind a global lock with ~20 IPC calls + in-lock D-Bus per
#   invocation, so bursty clicks piled up, hit `flock -w 10`, and were
#   silently discarded (32% under stress), leaving popups unclosable and
#   popup_open desynced from reality.
{{- $eww := includeTemplate "eww-sizes" . | fromJson }}
{{- $dowMdFontSize := mulf $eww.fontSize 0.74 | int }}
{{- $timeFontSize := mulf $eww.fontSize 1.14 | int }}
{{- $dowMdCharW := mulf $dowMdFontSize 0.6 | int }}
{{- $timeCharW := mulf $timeFontSize 0.6 | int }}
{{- $timeColW := mul $dowMdCharW 6 }}
{{- $timeMainW := mul $timeCharW 5 }}
{{- $timeComponentWidth := add (add (add $timeColW $timeMainW) 10) 12 }}
NEW="$1"

# eww runs button :onclick commands with a 200ms timeout and SIGKILLs whatever
# is still running (crates/eww/src/widgets/mod.rs). Detach immediately; the
# detached child records the intent and then either becomes the worker or
# exits (the running worker will see its intent).
if [ -z "$EWW_POPUP_DETACHED" ]; then
    EWW_POPUP_DETACHED=1 setsid nohup "$0" "$@" >/dev/null 2>&1 &
    exit 0
fi

dbg()  { [ -n "$EWW_POPUP_DEBUG" ] && echo "$(date +%H:%M:%S.%N) $$ $*" >> /tmp/popup-debug.log; return 0; }

# ---------------------------------------------------------------------------
# Phase 1: record the intent. This never blocks and never drops — the click
# is durable before any lock is touched. Mouse X is captured NOW: the worker
# may run seconds later, when the mouse has already moved elsewhere.
# ---------------------------------------------------------------------------
INTENTS=/tmp/eww-popup.intents
IWORK=/tmp/eww-popup.intents.work
MX=$(timeout 2 xdotool getmouselocation --shell 2>/dev/null | awk -F= '/^X=/ {print $2}')
echo "$NEW $MX" >> "$INTENTS"
dbg "intent queued: $NEW mx=$MX"

# ---------------------------------------------------------------------------
# Phase 2: worker election. The flock holder is THE popup worker and drains
# the queue. Everyone else exits — their intent is already queued, and the
# drain loop re-checks the queue continuously, so it cannot be missed.
# A wedged worker (>60s; healthy cycles are well under 1s) is killed so a
# stalled eww daemon can never freeze popups for good.
# ---------------------------------------------------------------------------
LOCKFILE=/tmp/eww-popup.lock
exec 9>"$LOCKFILE"
if ! flock -w 10 9; then
    victims=""
    stuck=0
    for p in $(fuser "$LOCKFILE" 2>&1 | tr ' ' '\n' | grep -xE '[0-9]+'); do
        [ "$p" = "$$" ] && continue
        victims="$victims $p"
        et=$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ')
        [ -n "$et" ] && [ "$et" -gt 60 ] && stuck=1
    done
    if [ "$stuck" = 1 ]; then
        dbg "watchdog: killing wedged worker:$victims"
        kill -9 $victims 2>/dev/null
        sleep 0.5
        flock -w 5 9 || { dbg "watchdog: still locked after kill"; exit 0; }
    else
        dbg "worker busy ($victims); intent queued, exiting"
        exit 0
    fi
fi

# ---------------------------------------------------------------------------
# Worker section. Exactly one process ever executes this.
# ---------------------------------------------------------------------------

# Child processes MUST NOT inherit fd 9 (9>&-): an inherited reference keeps
# the flock held even after this script dies (the year-long bluetoothctl scan
# process once poisoned every popup click this way). Every external call is
# time-bounded so a hung eww daemon stalls at most one bounded cycle.
# --no-daemonize is load-bearing: `eww open` that cannot reach the daemon
# auto-spawns an imposter which deletes the real daemon's socket and rebinds
# the path — silently hijacking ALL eww traffic (2026-08 stuck-OSD incident).
ewwc() { timeout 4 eww "$@" --no-daemonize 9>&- 2>/dev/null; }
xdc()  { timeout 3 xdotool "$@" 9>&- 2>/dev/null; }

# picom re-evaluates name/class-based exclude rules during a window's destroy
# frames, when WM_NAME/WM_CLASS/_NET_WM_WINDOW_TYPE are already unreadable; a
# dying fullscreen window (popup-scrim) then receives fullscreen blur+shadow
# painted on top of the composited scene for 2-3 frames = the visible flash
# when a popup closes. _NET_WM_WINDOW_OPACITY is cached by picom and honored
# at destroy (opacity 0 makes the renderer skip the dying window entirely),
# so hide the window at the X level before asking eww to destroy it.
# Requires detect-client-opacity = true in picom.conf.
prehide() { # $1 = eww window name
  local wid
  wid=$(xdc search --name "^Eww - $1\$" | head -1)
  [ -n "$wid" ] && timeout 2 xprop -id "$wid" -f _NET_WM_WINDOW_OPACITY 32c \
    -set _NET_WM_WINDOW_OPACITY 0 9>&- >/dev/null 2>&1
  return 0
}
close_win() { prehide "$1"; ewwc close "$1"; }

# Daemon health probe. A wedged eww daemon (documented long-uptime failure:
# window registry desync, hung IPC clients) cannot be repaired from here —
# restart it. Two failed probes guard against a transient stall.
if ! ewwc get popup_open >/dev/null 2>&1 && ! ewwc get popup_open >/dev/null 2>&1; then
    dbg "daemon unresponsive — restarting via launch.sh"
    i3-msg exec ~/.config/eww/scripts/launch.sh >/dev/null 2>&1
    exit 0
fi

# Recover a batch left behind by a killed worker.
if [ -s "$IWORK" ]; then
    cat "$IWORK" >> "$INTENTS"
    rm -f "$IWORK"
fi

POPUPS="profile-card network-popup control-center audio-popup bluetooth-popup calendar-popup notification-popup updates-popup power-popup storage-popup"

BAR_HEIGHT={{ $eww.barHeight }}
POPUP_GAP={{ $eww.popupGap }}
ICON_SIZE={{ $eww.iconSize }}
RIGHT_GAP={{ $eww.edgeGap }}
TIME_COMPONENT_WIDTH={{ $timeComponentWidth }}
RECONCILED="none"

has_compositor() {
  # This dotfiles uses picom as the X11 compositor. When it is not running
  # (e.g. in a VM to avoid flicker/CPU cost), skip the ARGB scrim so it does
  # not render as an opaque black fullscreen window.
  pgrep -x picom >/dev/null 2>&1
}

# The scrim must start below the ACTUAL bottom of the bar window. The baked
# barHeight can drift from the real window height (GTK grows the window when
# content exceeds :geometry), so measure the live window and fall back to the
# baked value.
compute_scrim_y() {
  local bar_win h
  bar_win=$(xdc search --name '^Eww - bar$' 2>/dev/null | head -1)
  h=$(xdc getwindowgeometry "$bar_win" 2>/dev/null | awk -F'[x ]' '/Geometry/ {print $NF}')
  if [ -n "$h" ]; then echo "$h"; else echo "{{ $eww.barHeight }}"; fi
}

# Compute the absolute left edge of a popup below the clicked component.
# Args: mouse_x component_width popup_width screen_width
# Prefer expanding to the right from the component's left edge, keeping
# RIGHT_GAP from the right edge of the screen. If there isn't enough room,
# fall back to expanding to the left from the component's right edge.
compute_popup_left() {
  local mouse_x="$1"
  local component_width="$2"
  local popup_width="$3"
  local screen_w="$4"
  local icon_left=$((mouse_x - component_width / 2))
  local icon_right=$((mouse_x + component_width / 2))

  if [ $((icon_left + popup_width + RIGHT_GAP)) -le "$screen_w" ]; then
    echo "$icon_left"
  else
    local left=$((icon_right - popup_width))
    if [ "$left" -lt 0 ]; then
      left=0
    fi
    echo "$left"
  fi
}

# Populate the array named by $1 with dynamic --arg arguments for right-side
# popups so they open directly below the clicked component.
# $2 = popup name, $3 = mouse x captured at click time (may be empty).
get_popup_pos_args() {
  local -n arr=$1
  local popup="$2"
  local mouse_x="$3"
  local screen_w x y

  [ -z "$mouse_x" ] && mouse_x=$(xdc getmouselocation --shell 2>/dev/null | awk -F= '/^X=/ {print $2}')
  screen_w=$(xdc getdisplaygeometry --shell 2>/dev/null | awk -F= '/^WIDTH=/ {print $2}')
  [ -z "$mouse_x" ] || [ -z "$screen_w" ] && return

  case "$popup" in
    network-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.networkW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    notification-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.notificationW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    control-center)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.controlW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    power-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.powerW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    audio-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.audioW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    bluetooth-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.btW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    calendar-popup)
      local component_width=$TIME_COMPONENT_WIDTH
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.calendarW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    updates-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.updateW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    storage-popup)
      local component_width=$((ICON_SIZE + 12))
      x=$(compute_popup_left "$mouse_x" "$component_width" "{{ $eww.storageW }}" "$screen_w")
      y=$((BAR_HEIGHT + POPUP_GAP))
      arr=(--arg pos_x="${x}px" --arg pos_y="${y}px")
      ;;
    *)
      ;;
  esac
}

scrim_is_open() {
  ewwc active-windows | grep -q '^popup-scrim:'
}

# Bounded wait for a window to appear/disappear in the daemon registry. eww
# applies window ops asynchronously on its GTK main thread: `eww open`
# returning does NOT mean the window exists yet.
wait_state() { # $1 window name, $2 present|absent
  local w="$1" want="$2" i
  for i in $(seq 1 10); do
    if [ "$want" = present ]; then
      timeout 2 eww active-windows --no-daemonize 9>&- 2>/dev/null | grep -q "^${w}:" && return 0
    else
      timeout 2 eww active-windows --no-daemonize 9>&- 2>/dev/null | grep -q "^${w}:" || return 0
    fi
    sleep 0.1
  done
  return 1
}

# popup_open must always mirror reality: it ends up naming the popup that is
# actually open (or none), the scrim follows the presence of any popup, and
# duplicate popups (should never happen) are closed.
reconcile() {
  local ACTIVE FINAL p
  ACTIVE=$(ewwc active-windows)
  FINAL="none"
  for p in $POPUPS; do
    if echo "$ACTIVE" | grep -q "^${p}:"; then
      if [ "$FINAL" = "none" ]; then
        FINAL="$p"
      else
        close_win "$p"
      fi
    fi
  done
  if [ "$FINAL" = "none" ]; then
    scrim_is_open && close_win popup-scrim
  else
    scrim_is_open || ewwc open popup-scrim --arg scrim_y="$(compute_scrim_y)px"
  fi
  ewwc update popup_open="$FINAL"
  RECONCILED="$FINAL"
  dbg "reconcile FINAL=$FINAL ACTIVE=[$(echo "$ACTIVE" | tr '\n' ' ')]"
}

process_intent() { # $1 target, $2 mouse_x captured at click time
  local INEW="$1" IMX="$2"
  case " $POPUPS close " in *" $INEW "*) ;; *) dbg "drop invalid intent: $INEW"; return ;; esac
  local CURRENT
  CURRENT=$(ewwc get popup_open || echo "none")
  dbg "exec NEW=$INEW CURRENT=$CURRENT mx=$IMX"
  if [ "$INEW" = "close" ]; then
    [ "$CURRENT" != "none" ] && { close_win "$CURRENT"; wait_state "$CURRENT" absent; }
    scrim_is_open && close_win popup-scrim
  elif [ "$CURRENT" = "$INEW" ]; then
    close_win "$INEW"
    wait_state "$INEW" absent
    scrim_is_open && close_win popup-scrim
  else
    # Ops are issued back-to-back with no intermediate waits: the daemon
    # applies them in submission order, and CURRENT != INEW is guaranteed in
    # this branch, so there is no same-window open/close ordering hazard.
    # A single bounded wait at the end covers the async window landing.
    [ "$CURRENT" != "none" ] && close_win "$CURRENT"
    if has_compositor && ! scrim_is_open; then
      ewwc open popup-scrim --arg scrim_y="$(compute_scrim_y)px"
    fi
    local pos_args=()
    get_popup_pos_args pos_args "$INEW" "$IMX"
    ewwc open "$INEW" "${pos_args[@]}"
    wait_state "$INEW" present
  fi
  reconcile
}

# X11 popup windows missing from the daemon registry are unclosable orphans
# (documented eww long-uptime registry desync). Use windowclose (a polite
# WM_DELETE the GTK window honors) — NEVER windowkill: XKillClient would kill
# the window's X connection, i.e. the eww daemon itself.
orphan_gc() {
  local ACTIVE w name short
  ACTIVE=$(ewwc active-windows)
  for w in $(xdc search --name '^Eww - ' 2>/dev/null); do
    name=$(xdc getwindowname "$w" 2>/dev/null) || continue
    short="${name#Eww - }"
    [ "$short" = "bar" ] && continue
    echo "$ACTIVE" | grep -q "^${short}:" && continue
    # Candidate orphan. Confirm across a second snapshot before destroying:
    # a window whose open op merely landed late must not be killed.
    sleep 1
    xdc getwindowname "$w" >/dev/null 2>&1 || continue
    ewwc active-windows | grep -q "^${short}:" && continue
    dbg "orphan-gc: closing orphan window $w ($name)"
    prehide "$short"
    xdc windowclose "$w"
  done
}

# Idle settle pass: absorb window ops that land late on the GTK main loop,
# then reconcile once more and garbage-collect orphans. The settle sleep is
# INTENT-INTERRUPTIBLE (0.1s poll): a click landing mid-settle is seen almost
# immediately and goes straight back to the drain loop — holding the lock
# through the settle must never delay a new click's popup.
settle() {
  local i
  for i in $(seq 1 20); do
    [ -s "$INTENTS" ] && return 1
    sleep 0.1
  done
  return 0
}

# Drain loop. `mv` is atomic: intents appended after the mv land in a fresh
# file and are picked up by the next iteration — no loss window.
while true; do
  while [ -s "$INTENTS" ]; do
    mv "$INTENTS" "$IWORK"
    while read -r INEW IMX || [ -n "$INEW" ]; do
      [ -n "$INEW" ] && process_intent "$INEW" "$IMX"
    done < "$IWORK"
    rm -f "$IWORK"
  done
  settle || continue
  reconcile
  [ -s "$INTENTS" ] && continue
  orphan_gc
  break
done

# Bluetooth discovery follows the final popup state, fire-and-forget:
# bt-scan.sh sync re-reads popup_open itself, so multiple pokes coalesce to
# the latest state, and a wedged bluetoothd cannot stall this worker.
( setsid ~/.config/eww/scripts/bt-scan.sh sync >/dev/null 2>&1 7>&- 8>&- 9>&- & )

# Refresh audio devices when the control center ends up open. Reads the
# ewwstate daemon's tmpfs snapshot (audio.py polls every 2s with internal 3s
# timeouts) — never run pactl round-trips on this path; a stalled PipeWire
# once wedged the global lock and made every popup unclosable.
if [ "$RECONCILED" = "control-center" ]; then
    AUDIO_JSON=$(timeout 3 ~/.config/eww/scripts/ewwstate get audio_devices 9>&- | tr -d '\n')
    [ -n "$AUDIO_JSON" ] && ewwc update audio_devices="$AUDIO_JSON"
fi

dbg "worker exit"
exit 0
