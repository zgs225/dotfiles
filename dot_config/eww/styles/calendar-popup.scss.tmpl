{{- $eww := includeTemplate "eww-sizes" . | fromJson -}}
{{- $calFs := mulf $eww.popupFontSize 0.86 | int -}}
{{- $calLineH := mulf $calFs 1.45 | int -}}

/* ============================================================ CALENDAR ============================================================ */
.cal {
  background-color: transparent;
  color: $subtext1;
  margin: 4px;
  font-size: {{ mulf $eww.popupFontSize 0.86 | int }}px;
}
calendar {
  background-color: transparent; color: $subtext1;
}
calendar.day-number { padding: 4px 0; }
calendar:selected {
  background-color: $accent; color: $bg-base;
  padding: 0 0 8px 0;
  background-clip: content-box;
  border-radius: 3px / 3px 3px 11px 11px;
}
calendar.header { color: $fg-primary; font-weight: bold; font-size: {{ mulf $eww.popupFontSize 0.94 | int }}px; }
calendar.button { color: $subtext0; padding: 4px; }
calendar.button:hover { color: $text; }
calendar:indeterminate { color: $overlay0; }
calendar.highlight { color: $accent; font-weight: bold; }

/* -- Date navigation bar -- */
.cal-nav { padding: 6px 4px; }
.cal-nav-btn {
  background: transparent;
  border: none;
  padding: 2px 6px;
  border-radius: $radius-sm;
}
.cal-nav-btn:hover { background: rgba($accent, 0.15); }
.cal-nav-arrow { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 1.10 | int }}px; }
.cal-nav-btn:hover .cal-nav-arrow { color: $fg-primary; }
.cal-nav-label { color: $fg-primary; font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px; font-weight: bold; }
.cal-nav-today { padding: 2px 8px; }
.cal-nav-today-label { color: $accent; font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px; }
.cal-nav-btn:hover .cal-nav-today-label { color: $fg-primary; }
.cal-nav-add { padding: 2px 8px; }
.cal-nav-add-label { color: $accent; font-size: {{ mulf $eww.popupFontSize 1.00 | int }}px; font-weight: bold; }
.cal-nav-btn:hover .cal-nav-add-label { color: $fg-primary; }

/* -- Events scroll area -- */
.cal-events-scroll { padding: 4px 8px 8px 8px; }

/* -- Event items with hover border-left (design doc 4.3) -- */
.event-item {
  border-left: 2px solid transparent;
  padding: 4px 0 4px 8px;
  border-radius: 0 $radius-sm $radius-sm 0;
}
.event-item:hover { border-left-color: $accent; background: rgba($accent, 0.06); }
.event-dot { min-width: 9px; min-height: 9px; border-radius: $radius-sm; margin-top: 5px; }
.event-dot-blue   { background-color: $accent; }
.event-dot-mauve  { background-color: $pink; }
.event-dot-green  { background-color: $green; }
.event-dot-peach  { background-color: $peach; }
.event-dot-teal   { background-color: $sapphire; }
.event-dot-yellow { background-color: $warn; }
.event-title { color: $text; font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px; }
.event-time  { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px; }
.event-acct  { color: $overlay0; font-size: {{ mulf $eww.popupFontSize 0.64 | int }}px; }
.events-empty { color: $overlay0; font-size: {{ mulf $eww.popupFontSize 0.76 | int }}px; padding: 8px 0; }

/* -- Delete button on event items -- */
.event-del-btn {
  background: transparent;
  border: none;
  padding: 2px 6px;
  border-radius: $radius-sm;
  opacity: 0;
}
.event-item:hover .event-del-btn { opacity: 1; }
.event-del-btn:hover { background: rgba($error, 0.20); }
.event-del-icon { color: $overlay0; font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px; }
.event-del-btn:hover .event-del-icon { color: $error; }
