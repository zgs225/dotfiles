{{- $eww := includeTemplate "eww-sizes" . | fromJson -}}

/* ============================================================ CALENDAR ADD POPUP ============================================================ */
.ca-popup {
  padding: 0;
}

/* -- Header -- */
.ca-header-row { padding: 14px 18px 10px 18px; }
.ca-header { color: $accent; font-size: {{ mulf $eww.popupFontSize 0.92 | int }}px; font-weight: bold; letter-spacing: 1px; }
.ca-close-btn { background: transparent; padding: 2px 6px; border-radius: $radius-sm; }
.ca-close-btn:hover { background: rgba($accent, 0.15); }
.ca-close-icon { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px; }
.ca-close-btn:hover .ca-close-icon { color: $fg-primary; }

/* -- Body -- */
.ca-body { padding: 14px 18px; }

/* -- Section labels -- */
.ca-section {
  color: $subtext0;
  font-size: {{ mulf $eww.popupFontSize 0.68 | int }}px;
  font-weight: bold;
  letter-spacing: 0.4px;
}

/* -- Chip buttons (toggle/select) -- */
.ca-chip {
  background: rgba($surface1, 0.40);
  border: 1px solid transparent;
  border-radius: $radius-sm;
  padding: 4px 10px;
}
.ca-chip:hover { background: rgba($surface2, 0.50); }
.ca-chip-label { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px; }
.ca-chip:hover .ca-chip-label { color: $fg-primary; }
/* Active/selected chip */
.ca-chip-on {
  background: rgba($accent, 0.20);
  border: 1px solid rgba($accent, 0.40);
}
.ca-chip-on .ca-chip-label { color: $accent; font-weight: bold; }
.ca-chip-on:hover { background: rgba($accent, 0.30); }

/* -- Title input -- */
.ca-title-input {
  background: rgba($surface1, 0.30);
  border: 1px solid rgba($accent, 0.20);
  border-radius: $radius-sm;
  padding: 6px 10px;
  color: $text;
  font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px;
  caret-color: $accent;
}
.ca-title-input:focus {
  border-color: rgba($accent, 0.50);
  background: rgba($surface1, 0.45);
}

/* -- Title display (legacy, kept for reference) -- */
.ca-title-display {
  color: $text;
  font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px;
  padding: 4px 8px;
  background: rgba($surface1, 0.30);
  border-radius: $radius-sm;
  border-left: 2px solid $accent;
}

/* -- Date label -- */
.ca-date-label {
  color: $fg-primary;
  font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px;
  font-weight: bold;
}

/* -- Arrow buttons (date nav, time +/-) -- */
.ca-arrow-btn {
  background: transparent;
  padding: 2px 8px;
  border-radius: $radius-sm;
}
.ca-arrow-btn:hover { background: rgba($accent, 0.15); }
.ca-arrow-icon { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 0.92 | int }}px; }
.ca-arrow-btn:hover .ca-arrow-icon { color: $fg-primary; }

/* -- Time display -- */
.ca-time-tag {
  color: $overlay0;
  font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px;
  min-width: {{ mulf $eww.popupFontSize 1.2 | int }}px;
}
.ca-time-val {
  color: $text;
  font-size: {{ mulf $eww.popupFontSize 0.88 | int }}px;
  font-family: "JetBrainsMono Nerd Font";
  font-weight: bold;
}

/* -- Weekday chip (generated by literal, uses same ca-chip classes) -- */
.ca-wd-chip {
  background: rgba($surface1, 0.40);
  border: 1px solid transparent;
  border-radius: $radius-sm;
  padding: 4px 6px;
  min-width: {{ mulf $eww.popupFontSize 1.6 | int }}px;
}
.ca-wd-chip:hover { background: rgba($surface2, 0.50); }
.ca-wd-label { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px; }
.ca-wd-chip:hover .ca-wd-label { color: $fg-primary; }
.ca-wd-on {
  background: rgba($accent, 0.20);
  border: 1px solid rgba($accent, 0.40);
}
.ca-wd-on .ca-wd-label { color: $accent; font-weight: bold; }

/* -- Account chip (generated by literal) -- */
.ca-acct-chip {
  background: rgba($surface1, 0.40);
  border: 1px solid transparent;
  border-radius: $radius-sm;
  padding: 4px 10px;
}
.ca-acct-chip:hover { background: rgba($surface2, 0.50); }
.ca-acct-label { color: $subtext0; font-size: {{ mulf $eww.popupFontSize 0.72 | int }}px; }
.ca-acct-chip:hover .ca-acct-label { color: $fg-primary; }
.ca-acct-on {
  background: rgba($accent, 0.20);
  border: 1px solid rgba($accent, 0.40);
}
.ca-acct-on .ca-acct-label { color: $accent; font-weight: bold; }
/* Account color dot inside chip */
.ca-acct-dot { min-width: 7px; min-height: 7px; border-radius: $radius-sm; }
.ca-acct-dot-blue   { background-color: $accent; }
.ca-acct-dot-mauve  { background-color: $pink; }
.ca-acct-dot-green  { background-color: $green; }
.ca-acct-dot-peach  { background-color: $peach; }
.ca-acct-dot-teal   { background-color: $sapphire; }
.ca-acct-dot-yellow { background-color: $warn; }

/* -- Footer -- */
.ca-footer { padding: 10px 18px 14px 18px; }
.ca-btn {
  padding: 8px 24px;
  border-radius: $radius;
}
.ca-btn-label { font-size: {{ mulf $eww.popupFontSize 0.82 | int }}px; font-weight: bold; }
.ca-btn-cancel { background: rgba($surface2, 0.50); }
.ca-btn-cancel:hover { background: rgba($surface2, 0.75); }
.ca-btn-cancel .ca-btn-label { color: $subtext0; }
.ca-btn-submit { background: rgba($accent, 0.80); }
.ca-btn-submit:hover { background: rgba($accent, 1.0); }
.ca-btn-submit .ca-btn-label { color: $bg-base; }
