[Unit]
Description=Idle auto-lock via xidlehook (per-power-source timeouts)
After=graphical-session.target

[Service]
Type=simple
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:0"
ExecStart=%h/.config/eww/scripts/idle-lock.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
