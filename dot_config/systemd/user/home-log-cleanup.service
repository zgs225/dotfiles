[Unit]
Description=Clean up app debug logs older than 14 days

[Service]
Type=oneshot
# Keep this line free of backslash escapes and % specifiers: systemd parses both
# before handing the string to sh (unknown escapes are preserved but logged as
# warnings on every unit load / daemon-reload). Hence two -name predicates in
# separate find passes instead of a grouped \( -o \) expression.
ExecStart=/bin/sh -c 'for d in "$HOME/.config/DingTalk/log" "$HOME/.config/Trae/logs" "$HOME/.config/Cursor/logs" "$HOME/.local/share/opencode/log"; do [ -d "$d" ] || continue; find "$d" -type f -name "*.log" -mtime +14 -delete; find "$d" -type f -name "*.log.*" -mtime +14 -delete; find "$d" -type d -empty -delete; done'
StandardOutput=journal
StandardError=journal
