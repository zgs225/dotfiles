{{ if .isMacOS -}}
# macOS: no chrome binary in PATH; use the system opener
export BROWSER=open
export FILE_MANAGER=open
{{ else -}}
# Linux (i3 desktop): dispatch via MIME defaults (~/.config/mimeapps.list → chrome)
export BROWSER=xdg-open
export FILE_MANAGER=thunar
{{ end -}}
export TERMINAL=wezterm
